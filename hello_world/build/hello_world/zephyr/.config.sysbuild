# sysbuild controlled configuration settings
CONFIG_ROM_END_OFFSET=0x40096
CONFIG_MCUBOOT_UPDATE_FOOTER_SIZE=0x40000
CONFIG_BOOTLOADER_MCUBOOT=y
CONFIG_MCUBOOT_SIGNATURE_KEY_FILE="/home/ubuntu/work/stm32f407_zephyr/hello_world/signing-key.pem"
CONFIG_MCUBOOT_ENCRYPTION_KEY_FILE=""
CONFIG_MCUBOOT_GENERATE_UNSIGNED_IMAGE=n
CONFIG_MCUBOOT_BOOTLOADER_MODE_SWAP_USING_MOVE=y
