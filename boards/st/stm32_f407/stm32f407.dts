/dts-v1/;
#include <st/f4/stm32f407Xg.dtsi>
#include <st/f4/stm32f407z(e-g)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h> 

/ {
    model = "Alientek STM32F407 Explorer Board";
    compatible = "alientek,stm32f407-explorer", "st,stm32f407";

    chosen {
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
        zephyr,uart-mcumgr = &usart1; //&cdc_acm_uart0;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,ccm = &ccm0;
        zephyr,code-partition = &slot0_partition;
    };

    
    eth_phy_reset: eth-phy-reset {
        compatible = "gpio-leds";
        phy_reset_pin: phy-reset-pin {
            gpios = <&gpiod 3 GPIO_ACTIVE_LOW>;
            label = "ETH_PHY_RESET";
        };
    };
    gpio_keys {
        compatible = "gpio-keys";
        user_button: button {
            label = "Key Up";
            gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
            zephyr,code = <INPUT_KEY_UP>;
        };
        key0: button_0 {
            label = "key0";
            gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_0>;
        };
        key1: button_1 {
            label = "key1";
            gpios = <&gpioe 3 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_1>;
        };
        key2: button_2 {
            label = "key2";
            gpios = <&gpioe 2 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_2>;
        };
    };


    aliases {

        sw0 = &user_button;
        sw1 = &key0;
        sw2 = &key1;
        sw3 = &key2;
        watchdog0 = &iwdg;
        //uart1 = &usart2;
    };
};

&dma1 {
    status = "okay";
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";

};


&clk_lsi {
    status = "okay";
};

&clk_hse {
    clock-frequency = <DT_FREQ_M(8)>;
    status = "okay";
};

&pll {
    div-m = <8>;
    mul-n = <336>;
    div-p = <2>;
    div-q = <7>;
    clocks = <&clk_hse>;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(168)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <4>;
    apb2-prescaler = <2>;
};


&rtc {
    clocks = <&rcc STM32_CLOCK_BUS_APB1 0x10000000>,
         <&rcc STM32_SRC_LSI RTC_SEL(2)>;
    status = "okay";

    backup_regs {
        status = "okay";
    };
};


&mac {
    status = "okay";
    zephyr,deferred-init;   //禁止自动初始化，延迟到应用程序中手动调用eth_phy_reset()函数进行初始化
    pinctrl-0 = <&eth_rxd0_pc4 &eth_rxd1_pc5 
                 &eth_ref_clk_pa1 &eth_crs_dv_pa7 
                 &eth_tx_en_pg11 &eth_txd0_pg13 
                 &eth_txd1_pg14>;
    pinctrl-names = "default";

    phy-connection-type = "rmii";
    phy-handle = <&eth_phy>;
};     
&mdio {
    status = "okay";
    zephyr,deferred-init;   //禁止自动初始化，延迟到应用程序中手动调用eth_phy_reset()函数进行初始化
    pinctrl-0 = <&eth_mdio_pa2 &eth_mdc_pc1>;
    pinctrl-names = "default";

    eth_phy: ethernet-phy@0 {
        compatible = "ethernet-phy";
        reg = <0>;  
        zephyr,deferred-init;
        // reset-gpios = <&gpiod 3 GPIO_ACTIVE_LOW>;
        //reset-assert-duration-us = <120000>;
        //reset-deassertion-timeout-ms = <50>;
    };
};   
&iwdg {
    status = "okay";
};

/*
 * Flash secctor 0 - 3: sector size = 16K
 * Flash secctor 4 : sector size = 64K
 * Flash secctor 5 - 11: sector size = 128K
 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(128)>;
            read-only;
        };

        slot0_partition: partition@20000 {
            label = "image-0";
            reg = <0x00020000 DT_SIZE_K(384)>;  /* 0x20000 到 0x7FFFF */
        };

        slot1_partition: partition@80000 {
            label = "image-1";
            reg = <0x00080000 DT_SIZE_K(384)>;  /* 0x80000 到 0xDFFFF */
        };

        storage_partition: partition@e0000 {
            label = "storage";
            reg = <0x000E0000 DT_SIZE_K(128)>;
        };
    };
};
